{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "AllowedHosts": "*",
  "ServerSettings": {
    "ApiKey": "network-monitor-2024-secret-key",
    "HeartbeatTimeoutMinutes": 10,
    "CleanupIntervalMinutes": 5,
    "MaxHistoryDays": 30,
    "EnableSwagger": true,
    "RequireApiKey": false
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5000",
      "http://localhost:3000",
      "https://yourdomain.com"
    ]
  }
}