@{
    ViewData["Title"] = "Network Monitor Server";
}

<div class="container mt-5">
    <div class="row">
        <div class="col-md-12">
            <h1 class="display-4">🌐 Network Monitor Server</h1>
            <p class="lead">Centralized monitoring dashboard for all Network Monitor clients</p>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-3">
            <div class="card text-white bg-primary mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Clients</h5>
                    <h2 class="card-text">@ViewBag.Stats.TotalClients</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-success mb-3">
                <div class="card-body">
                    <h5 class="card-title">Online Clients</h5>
                    <h2 class="card-text">@ViewBag.Stats.OnlineClients</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-info mb-3">
                <div class="card-body">
                    <h5 class="card-title">Total Devices</h5>
                    <h2 class="card-text">@ViewBag.Stats.TotalDevices</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card text-white bg-warning mb-3">
                <div class="card-body">
                    <h5 class="card-title">Online Devices</h5>
                    <h2 class="card-text">@ViewBag.Stats.OnlineDevices</h2>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5>Quick Links</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4">
                            <a href="/Home/Clients" class="btn btn-primary btn-lg btn-block mb-2">
                                <i class="fas fa-desktop"></i> View All Clients
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="/Home/Devices" class="btn btn-success btn-lg btn-block mb-2">
                                <i class="fas fa-network-wired"></i> View All Devices
                            </a>
                        </div>
                        <div class="col-md-4">
                            <a href="/Home/ApiDocs" class="btn btn-info btn-lg btn-block mb-2">
                                <i class="fas fa-book"></i> API Documentation
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <div class="row mt-4">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header">
                    <h5>API Endpoints</h5>
                </div>
                <div class="card-body">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Method</th>
                                <th>Endpoint</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><span class="badge bg-success">POST</span></td>
                                <td><code>/api/heartbeat</code></td>
                                <td>Send client heartbeat</td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-primary">GET</span></td>
                                <td><code>/api/devices/{clientId}</code></td>
                                <td>Get devices for a client</td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-success">POST</span></td>
                                <td><code>/api/devicestatus</code></td>
                                <td>Update device status</td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-primary">GET</span></td>
                                <td><code>/api/clients</code></td>
                                <td>Get all clients</td>
                            </tr>
                            <tr>
                                <td><span class="badge bg-primary">GET</span></td>
                                <td><code>/api/stats</code></td>
                                <td>Get server statistics</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>